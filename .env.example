# VeraScan Environment Variables
# Copy this file to .env and fill in your values

# === Backend (FastAPI) ===
SERPAPI_KEY=your_serpapi_key_here
# Cosine-similarity threshold for independent face verification (SFace).
# Candidate matches only when similarity >= threshold. Calibrated: same-person
# ~0.92-1.00, different-person ~0.16 on local fixtures. Conservative default:
FACE_MATCH_THRESHOLD=0.50
# Comma-separated frontend origin(s) allowed by FastAPI CORS.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 when unset.
# Set to your deployed site URL on hosting (e.g. https://verascan.vercel.app).
CORS_ORIGINS=http://localhost:3000

# === Blockchain ===
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=deployed_contract_address_here

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONTRACT_ADDRESS=deployed_contract_address_here
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
